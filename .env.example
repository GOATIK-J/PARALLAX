# PARALLAX configuration. Copy to .env. Every value below is a safe default or placeholder.
# No secrets are required: detectors run locally and the judge talks to a local Ollama.

PARALLAX_HOST=127.0.0.1
PARALLAX_PORT=8000
PARALLAX_ENVIRONMENT=production

# Browser origins allowed to call the API from a different origin (comma separated).
# Leave empty when the UI is served by the API itself at http://127.0.0.1:8000/ui/
PARALLAX_CORS_ORIGINS=

# Live pipeline (Arm R)
PARALLAX_ROUTER_THRESHOLD=0.35
PARALLAX_JUDGE_ENABLED=true
PARALLAX_JUDGE_MODEL=gemma3:4b
PARALLAX_OLLAMA_URL=http://localhost:11434
# Load D2/D3 weights at startup instead of on the first scan
PARALLAX_PRELOAD_MODELS=false

# Scan history is in-memory only. Set STORE_TEXT=false to keep just length + hash,
# or MAX_ITEMS=0 to disable history entirely.
PARALLAX_HISTORY_MAX_ITEMS=500
PARALLAX_HISTORY_STORE_TEXT=true
